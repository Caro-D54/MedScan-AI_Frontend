# URL base de la API de MedScan AI (Backend Spring Boot en puerto 8080 con prefijo /api/v1)

# Opción 1: iOS Simulator o Navegador Web
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Opción 2: Android Emulator (10.0.2.2 es el alias del host de la máquina de desarrollo)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Opción 3: Dispositivo Físico (Expo Go / Build local conectado por la misma red Wi-Fi)
# EXPO_PUBLIC_API_URL=http://192.168.1.X:8080/api/v1
